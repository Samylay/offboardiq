# OffboardIQ Environment Configuration
# Copy to .env.local and fill in your values

# Database (Vercel Postgres or any PostgreSQL)
DATABASE_URL=
# Or individual values:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=offboardiq_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT
JWT_SECRET=change-this-to-a-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider (Anthropic Claude)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@offboardiq.com

# Slack (optional)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
