# OffboardIQ Environment Configuration
# Copy to .env and fill in your values

NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=offboardiq_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@offboardiq.com

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Storage
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=us-east-1

# Frontend
FRONTEND_URL=http://localhost:5173

# Offboarding Defaults
DEFAULT_OFFBOARD_WINDOW=14
REMINDER_FREQ_HOURS=24
KNOWLEDGE_SCORE_THRESHOLD=0.7
